html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  font-family: 'Prompt', sans-serif;
  background: linear-gradient(135deg, #000428, #004e92, #00bfff);
  background-size: 500% 500%;
  animation: blueFlow 15s linear infinite;
  overflow: hidden;
}
@keyframes blueFlow {
  0% { background-position: 0% 0%; }
  50% { background-position: 100% 100%; }
  100% { background-position: 0% 0%; }
}
#bg-video {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: -1;
  filter: brightness(0.25);
}
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
  position: relative;
}
.box {
  background: rgba(0, 0, 0, 0.4);
  padding: 30px;
  border-radius: 12px;
  backdrop-filter: blur(6px);
  max-width: 400px;
  width: 100%;
  text-align: center;
  border: none;
  outline: none;
  animation: boxGlowGray 3s ease-in-out infinite;
}
h2 {
  color: #fff;
  margin-bottom: 20px;
  font-size: 24px;
}
input {
  width: 90%; max-width: 300px;
  padding: 14px 16px;
  font-size: 16px;
  border: none;
  border-radius: 8px;
  background-color: #222;
  color: #fff;
  text-align: center;
  margin-bottom: 20px;
}
button {
  background: #2196f3;
  color: #ffffff;
  padding: 12px 28px;
  font-size: 18px;
  font-weight: 550;
  border: none;
  border-radius: 999px;
  cursor: pointer;
  margin-top: 10px;
  transition: 0.2s ease;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.25);
}
button:hover {
  box-shadow: 0 0 16px rgba(255, 255, 255, 0.4);
}
.success-animate {
  animation: successPop 0.6s ease-out forwards;
}
@keyframes successPop {
  0% { opacity: 0; transform: scale(0.8) translateY(30px); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}
.bounce {
  animation: bounceClick 0.3s ease;
}
@keyframes bounceClick {
  0% { transform: scale(1); }
  30% { transform: scale(0.9); }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); }
}
#result {
  margin-top: 15px;
  font-weight: bold;
  font-size: 16px;
  color: #ffffff;
}
a.form-link {
  margin-top: 20px;
  display: inline-block;
  background: #2196f3;
  color: white;
  padding: 10px 24px;
  border-radius: 30px;
  text-decoration: none;
  box-shadow: 0 0 10px rgba(33,150,243,0.4);
  animation: floatUpDown 2.5s ease-in-out infinite, glow 2.5s ease-in-out infinite;
  transition: transform 0.3s;
}
@keyframes boxGlowGray {
  0%, 100% {
    box-shadow: 0 0 10px rgba(200, 200, 200, 0.2), 0 0 20px rgba(200, 200, 200, 0.1);
  }
  50% {
    box-shadow: 0 0 18px rgba(200, 200, 200, 0.3), 0 0 28px rgba(200, 200, 200, 0.15);
  }
}
.button-confirm {
  width: 20px;
  height: 20px;
  background-color: #ff4444;
  color: white;
  font-size: 30px;
  font-weight: normal;
  margin: 20px auto 0 auto;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(255, 68, 68, 0.3);
  transition: 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0;
}
.button-confirm:hover {
  box-shadow: 0 0 16px rgba(255, 68, 68, 0.5);
}
.emoji-car {
  position: fixed;
  bottom: 40px;
  right: -120px;
  font-size: 48px;
  animation: carDriftLeft 5s ease-in-out infinite;
  filter: drop-shadow(0 0 8px red);
  z-index: 9999;
}
@keyframes carDriftLeft {
  0% { right: -120px; transform: rotate(0deg); opacity: 0; }
  10% { opacity: 1; }
  25% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
  75% { transform: rotate(-2deg); }
  100% { right: 110%; transform: rotate(0deg); opacity: 0; }
}
